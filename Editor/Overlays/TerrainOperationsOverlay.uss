.terrain-op-button {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    height: auto;
    margin-bottom: 1.5px;
    padding-left: 1.5px;
    padding-right: 1.5px;
    background-color: rgb(84, 84, 84);
    color: rgb(219, 219, 219);
    border-radius: 4px;
    -unity-border-radius: 4px;
    -unity-font: url('project://database/Assets/ABAssets/AssetBundle/fonts/hyzhengyuan/HYZhengYuan-75W.ttf?fileID=12800000&guid=ebc4f2573897a3b4a8b4456f741c00f9&type=3#HYZhengYuan-75W');
    opacity: 1;
    flex-grow: 0;
    justify-content: flex-start;
    padding-top: 1.5px;
    padding-bottom: 2px;
    margin-left: 1.5px;
    margin-right: 1.5px;
    margin-top: 2px;
}

.terrain-op-button:hover {
    background-color: rgb(80, 80, 80);
}

.terrain-op-button:active {
    background-color: rgb(95, 95, 95);
}

.terrain-op-red {
    background-color: rgb(153, 34, 34);
}

.terrain-op-green {
    background-color: rgb(34, 153, 86);
}
