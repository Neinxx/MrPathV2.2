.reorderable-list-placeholder {
    background-color: rgba(0, 150, 255, 0.2);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-color: rgb(0, 150, 255);
    border-bottom-color: rgb(0, 150, 255);
    margin: 2px 0;
}

.reorderable-item {
    flex-direction: row;
    align-items: center;
    background-color: rgb(50, 50, 50);
    margin: 2px 0;
}

.reorderable-item.ghost {
    opacity: 0.7;
    z-index: 100;
    transition: none;
    background-color: rgb(70, 70, 70);
    border-width: 1px;
    border-color: rgb(0, 150, 255);
}
