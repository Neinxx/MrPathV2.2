

#pragma kernel paint_terrain

#include "BlendingLibrary.hlsl"
#include "BlendMaskLibrary.hlsl"
#include "Common.hlsl"

// Constants
#define FLT_INF 3.402823466e+38f

// Structs (must be defined before use)
struct layer_params {
    int           blend_mode;
    float         opacity;
    int           texture_index;
    int           terrain_layer_splat_index;
    float4        tiling_offset;
    float4        tint_color;
    GpuMaskParams mask_params;
};

// Input buffers
StructuredBuffer<layer_params> layer_params_buffer;
StructuredBuffer<float3>      spine_data;
StructuredBuffer<float2>      road_contour;

// Textures - 修改为float4格式以兼容GLES3
RWTexture2DArray<float4> splat_weights;  // 使用float4替代unorm float4
Texture2D<float> road_mask;
Texture2D<float> road_sdf;

// Uniforms
int    layer_count;
int    alphamap_layer_count;
int    spine_point_count;
float  falloff_distance;
float  road_width;
float2 terrain_size;
float2 terrain_position;
int2   alphamap_resolution;
int2   terrain_offset;
int2   alphamap_offset;
int2   coverage_min;
int2   coverage_max;
int    debug_mode;
int    contour_point_count;
float4 contour_bounds;
float  mask_threshold;
float  edge_width_world;
int    use_road_mask; // 当为1时启用 road_mask 门控；为0时不采样遮罩，按ROI与距离绘制

// Helper function to calculate squared distance
float distance_sq(float2 a, float2 b)
{
    float2 diff = a - b;
    return dot(diff, diff);
}

bool is_point_in_aabb(float2 p, float4 b)
{
    return !(p.x < b.x || p.y < b.y || p.x > b.z || p.y > b.w);
}

bool perform_ray_casting(float2 p)
{
    int n = contour_point_count;
    if (n < 3) return is_point_in_aabb(p, contour_bounds);
    bool inside = false;
    for (int i = 0, j = n - 1; i < n; j = i++)
    {
        float2 pi = road_contour[i];
        float2 pj = road_contour[j];
        bool intersect = (pi.y > p.y) != (pj.y > p.y);
        if (!intersect) continue;
        float denom = pj.y - pi.y;
        if (abs(denom) <= 1e-6) continue;
        float ix = (pj.x - pi.x) * (p.y - pi.y) / denom + pi.x;
        if (p.x < ix) inside = !inside;
    }
    return inside;
}

float distance_to_segment(float2 p, float2 a, float2 b)
{
    float2 ab = b - a;
    float denom = dot(ab, ab);
    float t = 0.0;
    if (denom > 1e-8) t = saturate(dot(p - a, ab) / denom);
    float2 q = a + t * ab;
    return length(p - q);
}

float distance_to_contour_edge(float2 p)
{
    uint n = (uint)contour_point_count;
    if (n < 2u) return 0.0;
    float d = FLT_INF;
    
    for (uint i = 0u; i < n; i++)
    {
        float2 a = road_contour[i];
        uint nextIndex = (i + 1u) % n;
        float2 b = road_contour[nextIndex];
        d = min(d, distance_to_segment(p, a, b));
    }
    return d;
}

float3 calculate_distance_progress_signed(float2 world_pos, StructuredBuffer<float3> spine_data, int spine_point_count)
{
    float totalLen = 0.0f;

    for(int segIdx = 0; segIdx < spine_point_count - 1; segIdx++)
    {
        float2 s = spine_data[segIdx].xz;
        float2 e = spine_data[segIdx + 1].xz;
        float2 d = e - s;
        totalLen += length(d);
    }
    totalLen = max(1e-6f, totalLen);

    float min_distance_sq = FLT_INF;
    float progress_len = 0.0f;
    float accum_len = 0.0f;
    float signed_dist = 0.0f;

    for(int seg_idx2 = 0; seg_idx2 < spine_point_count - 1; seg_idx2++)
    {
        float3 p1 = spine_data[seg_idx2];
        float3 p2 = spine_data[seg_idx2 + 1];

        float2 segment_start = p1.xz;
        float2 segment_end = p2.xz;
        float2 segment_dir = segment_end - segment_start;
        float  segment_len_sq = dot(segment_dir, segment_dir);
        float  segment_len = sqrt(max(0.0f, segment_len_sq));

        float  t = 0.0f;
        float2 closest_point = segment_start; 
        float  distSq = FLT_INF;

        if(segment_len_sq > 1e-8f)
        {
            t = saturate(dot(world_pos - segment_start, segment_dir) / segment_len_sq);
            closest_point = segment_start + t * segment_dir;
            float2 to_point = world_pos - closest_point;
            float2 normal2d = (segment_len_sq > 0.0f) ? normalize(float2(-segment_dir.y, segment_dir.x)) : float2(0.0f, 1.0f);
            distSq = dot(to_point, to_point);
            float dist_signed = dot(to_point, normal2d);
            if(distSq < min_distance_sq)
            {
                min_distance_sq = distSq;
                float along_len = accum_len + t * segment_len;
                progress_len = saturate(along_len / totalLen);
                signed_dist = dist_signed;
            }
        }
        accum_len += segment_len;
    }

    return float3(sqrt(min_distance_sq), progress_len, signed_dist);
}

// 新增：确保值在[0,1]范围内并转换为线性空间
float4 clamp_to_linear(float4 value)
{
    return saturate(value);  // 替代unorm的自动范围处理
}

void apply_blending(int2 pixel_coord, layer_params layer, float distance_abs, float progress, float signed_distance, float mask_gate)
{
    // distance_abs 现传入的是 edgeFactor（0..1）：中心=1，边界外=0
    float falloff = saturate(distance_abs);

    float2 world_pos = terrain_position + float2(terrain_offset) * terrain_size + (float2(pixel_coord) + 0.5f) * terrain_size / alphamap_resolution;
    float  mask_value = EvaluateMask(layer.mask_params, world_pos, progress, signed_distance, road_width);

    float final_strength = layer.opacity * falloff * mask_value * mask_gate;
    if(final_strength <= 0.0f) return;

    int splat_idx_signed = layer.terrain_layer_splat_index;
    if(splat_idx_signed < 0 || splat_idx_signed >= alphamap_layer_count)
    {
        splat_idx_signed = 0;
    }

    uint splat_index = (uint)splat_idx_signed;
    uint alphamap_index = splat_index / 4u;
    uint channel_index = splat_index % 4u;

    // 读取当前值并确保在有效范围内
    float4 current_alpha = splat_weights[int3(pixel_coord, alphamap_index)];
    current_alpha = clamp_to_linear(current_alpha);

    float base_weight = (channel_index == 0) ? current_alpha.r
                      : (channel_index == 1) ? current_alpha.g
                      : (channel_index == 2) ? current_alpha.b
                      : current_alpha.a;
                      
    float blended_weight = BlendWeight(base_weight, final_strength, layer.blend_mode);
    blended_weight = saturate(blended_weight);

    if(channel_index == 0) current_alpha.r = blended_weight;
    else if(channel_index == 1) current_alpha.g = blended_weight;
    else if(channel_index == 2) current_alpha.b = blended_weight;
    else current_alpha.a = blended_weight;

    // 写入前再次确保值在[0,1]范围
    splat_weights[int3(pixel_coord, alphamap_index)] = clamp_to_linear(current_alpha);
}

[numthreads(8, 8, 1)]
void paint_terrain(uint3 id : SV_DispatchThreadID)
{
    int2 pixel_coord = int2(id.xy) + alphamap_offset;

    if(pixel_coord.x < 0 || pixel_coord.y < 0 || pixel_coord.x >= alphamap_resolution.x || pixel_coord.y >= alphamap_resolution.y) return;

    if(pixel_coord.x < coverage_min.x || pixel_coord.y < coverage_min.y || pixel_coord.x > coverage_max.x || pixel_coord.y > coverage_max.y) return;

    float2 world_pos = terrain_position + float2(terrain_offset) * terrain_size + (float2(pixel_coord) + 0.5f) * terrain_size / alphamap_resolution;

    float3 dps = calculate_distance_progress_signed(world_pos, spine_data, spine_point_count);
    float  progress = dps.y;
    float  signed_distance = dps.z;

    float halfRoad = max(1e-6, road_width * 0.5);

    // 遮罩门控：默认允许绘制；仅当启用时采样 road_mask 并进行门控
    float maskGate = 1.0;
    if (use_road_mask == 1)
    {
        float mask_sample = road_mask.Load(int3(pixel_coord, 0));
        maskGate = (mask_sample > mask_threshold) ? 1.0 : 0.0;
        if (maskGate <= 0.0) return;
    }

    // 使用 signed_distance 计算边缘因子：中心=1，超出道路+边缘宽度=0
    float edgeFactor = saturate(1.0 - max(0.0, abs(signed_distance) - halfRoad) / max(edge_width_world, 1e-6));

    if(debug_mode == 1)
    {
        float2 uvOut = float2(0.0, 0.0);
        if(layer_count > 0)
        {
            layer_params layer0 = layer_params_buffer[0];
            uvOut = ComputeMaskUV(progress, signed_distance, road_width, layer0.mask_params.Noise);
        }
        // 调试输出也确保在有效范围
        splat_weights[int3(pixel_coord, 0)] = clamp_to_linear(float4(uvOut.x, uvOut.y, 0, 1));
        return;
    }

    // 原先无条件的调试写入导致始终提前返回，这里改为仅在 debug_mode==2 时输出
    else if (debug_mode == 2)
    {
        float fall = edgeFactor;
        splat_weights[int3(pixel_coord, 0)] = clamp_to_linear(float4(fall, 0, 0, 1));
        return;
    }

    // 正常模式：对所有图层执行混合
    for(int layerIdx = 0; layerIdx < layer_count; layerIdx++)
    {
        layer_params layer = layer_params_buffer[layerIdx];
        apply_blending(pixel_coord, layer, edgeFactor, progress, signed_distance, maskGate);
    }
}
