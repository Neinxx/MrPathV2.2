

#pragma kernel PaintTerrain

#include "BlendingLibrary.hlsl"
#include "BlendMaskLibrary.hlsl"
#include "Common.hlsl"

// Constants
#define FLT_INF 3.402823466e+38f

// Structs (must be defined before use)
struct LayerParams {
	int           BlendMode;
	float         Opacity;
	int           TextureIndex;
	int           TerrainLayerSplatIndex;
	float4        TilingOffset;
	float4        TintColor;
	GpuMaskParams MaskParams;
};

// Input buffers
StructuredBuffer<LayerParams> LayerParamsBuffer;
StructuredBuffer<float3>      SpineData;

// Textures
RWTexture2DArray<unorm float4> _SplatWeights;

// Uniforms
int    _LayerCount;
int    _AlphamapLayerCount;
int    _SpinePointCount;
float  _BrushSize;
float  _BrushStrength;
float  _FalloffDistance;
float  _RoadWidth;
float2 _TerrainSize;
float2 _TerrainPosition;
int2   _AlphamapResolution;
int2   _TerrainOffset;
int2   _AlphamapOffset;
int2   _CoverageMin;   // 新增：覆盖范围最小像素坐标
int2   _CoverageMax;   // 新增：覆盖范围最大像素坐标
int    _DebugMode; // 新增：调试模式 0=正常, 1=UV渐变, 2=道路衰减


// Helper function to calculate squared distance
float distanceSq(float2 a, float2 b)
{
	float2 diff = a - b;
	return dot(diff, diff);
}

// Calculate distance, progress (length-normalized) and signed distance across the path
float3 CalculateDistanceProgressSigned(float2 worldPos, StructuredBuffer<float3> spineData, int spinePointCount)
{
	// First pass: total path length
	float totalLen = 0.0f;

	
	for(int segIdx = 0; segIdx < spinePointCount - 1; segIdx++)
	{
		float2 s = spineData[segIdx].xz;
        float2 e = spineData[segIdx + 1].xz;
		float2 d = e - s;
		totalLen += length(d);
	}
	totalLen = max(1e-6f, totalLen);

	// Second pass: find closest segment; compute progress by length and signed distance
	float minDistanceSq = FLT_INF;
	float progressLen = 0.0f;
	float accumLen = 0.0f;
	float signedDist = 0.0f;

	for(int segIdx2 = 0; segIdx2 < spinePointCount - 1; segIdx2++)
	{
		float3 p1 = spineData[segIdx2];
		float3 p2 = spineData[segIdx2 + 1];

		float2 segmentStart = p1.xz;
        float2 segmentEnd = p2.xz;
		float2 segmentDir = segmentEnd - segmentStart;
		float  segmentLenSq = dot(segmentDir, segmentDir);
		float  segmentLen = sqrt(max(0.0f, segmentLenSq));

		float  t = 0.0f;
		float2 closestPoint = segmentStart;
		float  distSq = FLT_INF;

		if(segmentLenSq > 1e-8f)
		{
			t = saturate(dot(worldPos - segmentStart, segmentDir) / segmentLenSq);
			closestPoint = segmentStart + t * segmentDir;
			float2 toPoint = worldPos - closestPoint;
			// Per-segment normal (perpendicular, right-handed)
			float2 normal2d = (segmentLenSq > 0.0f) ? normalize(float2(-segmentDir.y, segmentDir.x)) : float2(0.0f, 1.0f);
			distSq = dot(toPoint, toPoint);
			// Signed distance uses dot with the perpendicular
			float distSigned = dot(toPoint, normal2d);
			if(distSq < minDistanceSq)
			{
				minDistanceSq = distSq;
				float alongLen = accumLen + t * segmentLen;
				progressLen = saturate(alongLen / totalLen);
				signedDist = distSigned;
			}
		}
		else
		{
			// Degenerate segment: keep accumLen only
		}

		accumLen += segmentLen;
	}

	return float3(sqrt(minDistanceSq), progressLen, signedDist);
}

// Apply blending based on layer parameters
void ApplyBlending(int2 pixelCoord, LayerParams layer, float distanceAbs, float progress, float signedDistance)
{
	// Calculate brush falloff
	float falloff = 1.0f - saturate(distanceAbs / _FalloffDistance);
	if(falloff <= 0.0f) return;

	// Evaluate mask with recipe-provided params
	float2 worldPos = _TerrainPosition + float2(_TerrainOffset) * _TerrainSize + (float2(pixelCoord) + 0.5f) * _TerrainSize / _AlphamapResolution;
	float  maskValue = EvaluateMask(layer.MaskParams, worldPos, progress, signedDistance, _RoadWidth);

	// Calculate final strength using recipe opacity
	float finalStrength = layer.Opacity * falloff * maskValue * _BrushStrength;
	if(finalStrength <= 0.0f) return;

	// Validate splat index (fallback to 0 when invalid)
	int splatIdxSigned = layer.TerrainLayerSplatIndex;
	if(splatIdxSigned < 0 || splatIdxSigned >= _AlphamapLayerCount)
	{
		splatIdxSigned = 0; // 安全回退，避免完全不绘制
	}

	// Map to alphamap slice/channel via terrain splat index
	uint splatIndex = (uint)splatIdxSigned;
	uint alphamapIndex = splatIndex / 4u;
	uint channelIndex = splatIndex % 4u;

	// Read current alpha before blending
	float4 currentAlpha = _SplatWeights[int3(pixelCoord, alphamapIndex)];

	// Blend per selected channel using unified BlendMode weight function
	float baseWeight = (channelIndex == 0)
					   ? currentAlpha.r
					   : (channelIndex == 1)
					   ? currentAlpha.g
					   : (channelIndex == 2)
					   ? currentAlpha.b
					   : currentAlpha.a;
	float blendedWeight = BlendWeight(baseWeight, finalStrength, layer.BlendMode);
	blendedWeight = saturate(blendedWeight);

	if(channelIndex == 0) currentAlpha.r = blendedWeight;
	else if(channelIndex == 1) currentAlpha.g = blendedWeight;
	else if(channelIndex == 2) currentAlpha.b = blendedWeight;
	else /* channelIndex == 3 */ currentAlpha.a = blendedWeight;

	// Replace local normalization with shared helper to keep multiple channels sum=1
	currentAlpha = NormalizeWeightsKeep(currentAlpha);

	_SplatWeights[int3(pixelCoord, alphamapIndex)] = currentAlpha;
}

[numthreads(8, 8, 1)]
void PaintTerrain(uint3 id : SV_DispatchThreadID)
{
    // Map threads into the coverage window using the alphamap offset
    int2 pixelCoord = int2(id.xy) + _AlphamapOffset;

    // Bounds check (supports negative offsets safely)
    if(pixelCoord.x < 0 || pixelCoord.y < 0 || pixelCoord.x >= _AlphamapResolution.x || pixelCoord.y >= _AlphamapResolution.y) return;

    // 新增：裁剪到覆盖包围盒，避免调度超出 ROI 的线程做无效计算
    if(pixelCoord.x < _CoverageMin.x || pixelCoord.y < _CoverageMin.y || pixelCoord.x > _CoverageMax.x || pixelCoord.y > _CoverageMax.y) return;


    // 调试：检查spine数据是否有效
    if(_SpinePointCount <= 0)
    {
        // 如果没有spine数据，将像素设为红色以便调试
        {
            _SplatWeights[int3(pixelCoord, 0)] = float4(1, 0, 0, 0);
        }
        return;
    }

    // 调试：检查第一个spine点是否有效
    if(_SpinePointCount > 0)
    {
        float3 firstPoint = SpineData[0];
        // 如果第一个点的坐标都是0，可能数据有问题
        if(abs(firstPoint.x) < 0.001f && abs(firstPoint.y) < 0.001f && abs(firstPoint.z) < 0.001f)
        {
            // 将左上角设为蓝色表示spine数据可能有问题
            if(pixelCoord.x < 10 && pixelCoord.y < 10)
            {
                _SplatWeights[int3(pixelCoord, 0)] = float4(0, 0, 1, 0);
            }
            return;
        }
    }

    // Convert to world position
    float2 worldPos = _TerrainPosition + float2(_TerrainOffset) * _TerrainSize + (float2(pixelCoord) + 0.5f) * _TerrainSize / _AlphamapResolution;

    // Calculate distance, progress and signed distance along the path
    float3 dps = CalculateDistanceProgressSigned(worldPos, SpineData, _SpinePointCount);
    float  distanceAbs = dps.x;
    float  progress = dps.y;
    float  signedDistance = dps.z;

    // 新增：调试模式分支（在获得 progress/signedDistance 后输出UV）
    if(_DebugMode == 1)
    {
        // 使用第一个图层的噪声参数计算统一UV；若无图层则输出0
        float2 uvOut = float2(0.0, 0.0);
        if(_LayerCount > 0)
        {
            LayerParams layer0 = LayerParamsBuffer[0];
            uvOut = ComputeMaskUV(progress, signedDistance, _RoadWidth, layer0.MaskParams.Noise);
        }
        _SplatWeights[int3(pixelCoord, 0)] = float4(uvOut.x, uvOut.y, 0, 1);
        return;
    }

    // 新增：调试模式 2，写入道路衰减查看覆盖范围
    if(_DebugMode == 2)
    {
        float fall = 1.0f - saturate(distanceAbs / max(_FalloffDistance, 1e-6));
        _SplatWeights[int3(pixelCoord, 0)] = float4(fall, 0, 0, 1);
        return;
    }

    // Skip if too far from path
    if(distanceAbs > _FalloffDistance) return;

    // Within falloff we proceed to layer blending (no debug writes)

    // Apply each layer
    for(int layerIdx = 0; layerIdx < _LayerCount; layerIdx++)
    {
        LayerParams layer = LayerParamsBuffer[layerIdx];
        ApplyBlending(pixelCoord, layer, distanceAbs, progress, signedDistance);
    }
}
