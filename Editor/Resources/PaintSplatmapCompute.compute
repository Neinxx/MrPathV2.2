#pragma kernel PaintTerrain

#include "Assets/__temp/MrPathV2.2/Runtime/Shaders/Includes/BlendingLibrary.hlsl"
#include "BlendMaskLibrary.hlsl"
#include "Common.hlsl"

// Constants
#define FLT_INF 3.402823466e+38f

// Structs (must be defined before use)
struct LayerParams
{
    int BlendMode;
    float Opacity;
    int TextureIndex;
    int TerrainLayerSplatIndex;
    float4 TilingOffset;
    float4 TintColor;
    GpuMaskParams MaskParams;
};

// Input buffers
StructuredBuffer<LayerParams> LayerParamsBuffer;
StructuredBuffer<float3> SpineData;

// Textures
RWTexture2DArray<unorm float4> _SplatWeights;

// Uniforms
int _LayerCount;
int _AlphamapLayerCount;
int _SpinePointCount;
float _BrushSize;
float _BrushStrength;
float _FalloffDistance;
float _RoadWidth;
float2 _TerrainSize;
float2 _TerrainPosition;
int2 _AlphamapResolution;
int2 _TerrainOffset;
int2 _AlphamapOffset;

// Helper function to calculate squared distance
float distanceSq(float2 a, float2 b)
{
    float2 diff = a - b;
    return dot(diff, diff);
}

// Calculate distance and progress along the path
float2 CalculateDistanceAndProgress(float2 worldPos, StructuredBuffer<float3> spineData, int spinePointCount)
{
    float minDistanceSq = FLT_INF;
    float progress = 0.0f;
    
    for (int i = 0; i < spinePointCount - 1; i++)
    {
        float3 p1 = spineData[i];
        float3 p2 = spineData[i + 1];
        
        float2 segmentStart = p1.xy;
        float2 segmentEnd = p2.xy;
        float2 segmentDir = segmentEnd - segmentStart;
        float segmentLengthSq = dot(segmentDir, segmentDir);
        
        if (segmentLengthSq > 0.0001f)
        {
            float t = saturate(dot(worldPos - segmentStart, segmentDir) / segmentLengthSq);
            float2 closestPoint = segmentStart + t * segmentDir;
            float distSq = distanceSq(worldPos, closestPoint);
            
            if (distSq < minDistanceSq)
            {
                minDistanceSq = distSq;
                progress = (float(i) + t) / float(spinePointCount - 1);
            }
        }
    }
    
    return float2(sqrt(minDistanceSq), progress);
}

// Apply blending based on layer parameters
void ApplyBlending(int2 pixelCoord, LayerParams layer, float distance, float progress)
{
    // Calculate brush falloff
    float falloff = 1.0f - saturate(distance / _FalloffDistance);
    if (falloff <= 0.0f) return;

    // Evaluate mask with recipe-provided params
    float2 worldPos = _TerrainPosition + float2(_TerrainOffset) * _TerrainSize + float2(pixelCoord) * _TerrainSize / _AlphamapResolution;
    float maskValue = EvaluateMask(layer.MaskParams, worldPos, progress, distance, _RoadWidth);

    // Calculate final strength using recipe opacity
    float finalStrength = layer.Opacity * falloff * maskValue * _BrushStrength;
    if (finalStrength <= 0.0f) return;

    // Validate splat index
    int splatIdxSigned = layer.TerrainLayerSplatIndex;
    if (splatIdxSigned < 0 || splatIdxSigned >= _AlphamapLayerCount) return;

    // Map to alphamap slice/channel via terrain splat index
    uint splatIndex = (uint)splatIdxSigned;
    uint alphamapIndex = splatIndex / 4u;
    uint channelIndex = splatIndex % 4u;

    // Read current alpha before blending
    float4 currentAlpha = _SplatWeights[int3(pixelCoord, alphamapIndex)];

    // Blend per selected channel using unified BlendMode weight function
    float baseWeight = (channelIndex == 0) ? currentAlpha.r : (channelIndex == 1) ? currentAlpha.g : (channelIndex == 2) ? currentAlpha.b : currentAlpha.a;
    float blendedWeight = BlendWeight(baseWeight, finalStrength, layer.BlendMode);
    blendedWeight = saturate(blendedWeight);

    if (channelIndex == 0) currentAlpha.r = blendedWeight;
    else if (channelIndex == 1) currentAlpha.g = blendedWeight;
    else if (channelIndex == 2) currentAlpha.b = blendedWeight;
    else /* channelIndex == 3 */ currentAlpha.a = blendedWeight;

    // Replace local normalization with shared helper to keep multiple channels sum=1
    currentAlpha = NormalizeWeightsKeep(currentAlpha);

    _SplatWeights[int3(pixelCoord, alphamapIndex)] = currentAlpha;
}

[numthreads(8, 8, 1)]
void PaintTerrain(uint3 id : SV_DispatchThreadID)
{
    int2 pixelCoord = int2(id.xy) + _AlphamapOffset;
    
    // Check bounds
    if (pixelCoord.x >= _AlphamapResolution.x || pixelCoord.y >= _AlphamapResolution.y)
        return;
    
    // Convert to world position
    float2 worldPos = _TerrainPosition + float2(_TerrainOffset) * _TerrainSize + float2(pixelCoord) * _TerrainSize / _AlphamapResolution;
    
    // Calculate distance and progress along the path
    float2 distanceAndProgress = CalculateDistanceAndProgress(worldPos, SpineData, _SpinePointCount);
    float distance = distanceAndProgress.x;
    float progress = distanceAndProgress.y;
    
    // Skip if too far from path
    if (distance > _FalloffDistance) return;
    
    // Apply each layer
    for (int layerIdx = 0; layerIdx < _LayerCount; layerIdx++)
    {
        LayerParams layer = LayerParamsBuffer[layerIdx];
        ApplyBlending(pixelCoord, layer, distance, progress);
    }
}