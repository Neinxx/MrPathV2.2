<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/MrPathV2/Editor/Inspectors/PathProfileEditor.uss?fileID=7433441132597879392&amp;guid=036bccdb4eb9e0e40a55bc40ccb90145&amp;type=3#PathProfileEditor" />
    <ui:VisualElement style="flex-direction: row; justify-content: space-between; height: 20px; flex-grow: 0; margin-bottom: 6px;">
        <ui:Button text="Button" display-tooltip-when-elided="true" name="all" style="flex-shrink: 1; flex-grow: 1;" />
        <ui:Button text="Button" display-tooltip-when-elided="true" name="holded" style="flex-shrink: 1; flex-grow: 1;" />
        <ui:Button text="Button" display-tooltip-when-elided="true" name="notHolded" style="flex-shrink: 1; flex-grow: 1;" />
        <ui:VisualElement style="flex-grow: 1; width: 200px;" />
        <ui:Button text="Button" display-tooltip-when-elided="true" name="refresh" style="flex-shrink: 1; flex-grow: 1;" />
