    <ui:VisualElement class="object-field" style="padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; margin-left: 4px; margin-right: 4px; margin-top: 4px; margin-bottom: 4px; flex-grow: 0; height: 36px;">
        <ui:TextField picking-mode="Ignore" label="search" value="filler text" text="filler text" style="flex-shrink: 1; flex-grow: 1;" />
    </ui:VisualElement>
    <ui:VisualElement class="settings-group" style="flex-grow: 1; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 5px; padding-top: 12px;">
        <ui:ListView focusable="true" />
