    <ui:GroupBox class="settings-group" style="height: 96px; flex-direction: row; margin-left: 10px; margin-right: 10px; margin-top: 5px; margin-bottom: 10px;">
        <ui:VisualElement name="Icon" style="width: 81px; height: 74px;" />
