<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/MrPathV2/Editor/Inspectors/PathProfileEditor.uss?fileID=7433441132597879392&amp;guid=036bccdb4eb9e0e40a55bc40ccb90145&amp;type=3#PathProfileEditor" />
    <Style src="project://database/Assets/MrPathV2/Editor/Styles/Buttons.uss?fileID=7433441132597879392&amp;guid=7a5f1ad5cec050e4eb224a56c9e215a3&amp;type=3#Buttons" />
    <ui:GroupBox picking-mode="Ignore" class="settings-group" style="flex-shrink: initial; flex-direction: column; justify-content: space-around; align-items: stretch; flex-grow: initial; padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px; margin-left: 8px; margin-right: 8px; margin-top: 8px; margin-bottom: 8px; border-left-color: rgb(65, 65, 65); border-right-color: rgb(65, 65, 65); border-top-color: rgb(65, 65, 65); border-bottom-color: rgb(65, 65, 65); border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px; background-color: rgb(46, 46, 46); height: 113px;">
        <ui:VisualElement style="justify-content: space-between; align-items: stretch; padding-left: 6px; padding-right: 3px; flex-grow: 1;">
            <ui:VisualElement focusable="false" tabindex="0" style="flex-direction: row; justify-content: space-between; align-items: center; width: auto; flex-grow: 1; flex-shrink: 1; flex-wrap: nowrap; margin-bottom: 6px; margin-top: 12px;">
                <ui:Toggle name="Activelayer" style="flex-shrink: 1; flex-grow: 0; justify-content: center; flex-direction: row-reverse; align-items: stretch; left: auto; width: 21px; scale: 1.35 1.35; border-left-width: 0.5px;" />
                <ui:Label text="Layer" display-tooltip-when-elided="true" name="Layername" style="font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-left; flex-shrink: 1; flex-grow: 0; color: rgba(210, 210, 210, 0.22); padding-right: 3px; width: 53px;" />
                <ui:VisualElement style="align-items: center; flex-direction: row; justify-content: space-between; flex-grow: 1; min-height: 20px; max-height: 20px; margin-left: 20px; padding-right: 0; margin-right: 0;">
                    <ui:DropdownField index="-1" choices="System.Collections.Generic.List`1[System.String]" name="BlendModelEnum" style="flex-grow: 0; background-color: rgb(0, 0, 0); opacity: 0.44; flex-shrink: 1; margin-left: 2px; width: 72px; height: 14px;" />
                    <ui:Slider picking-mode="Ignore" value="42" high-value="100" name="LayerOpacity" style="flex-grow: 1; min-width: 0; max-width: none; min-height: 20px; max-height: 20px; flex-shrink: 1; margin-right: 7px; opacity: 1;" />
                </ui:VisualElement>
                <ui:Button display-tooltip-when-elided="true" name="RemoveLayer" class="AnimatedButton" style="margin-left: 0; margin-right: 2px; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; flex-shrink: 1; flex-grow: 1; border-top-left-radius: 66px; border-bottom-left-radius: 66px; border-top-right-radius: 66px; border-bottom-right-radius: 66px; width: 18px; white-space: nowrap; -unity-text-align: middle-center; opacity: 0.56; height: 18px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; max-height: 18px; border-left-color: rgba(0, 0, 0, 0.9); border-right-color: rgba(0, 0, 0, 0.9); border-top-color: rgba(0, 0, 0, 0.9); border-bottom-color: rgba(0, 0, 0, 0.9); min-height: 18px; max-width: 18px; min-width: 18px; font-size: 6px; -unity-font-style: bold;" />
            </ui:VisualElement>
            <ui:VisualElement style="left: auto; padding-right: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; flex-grow: 1; min-height: initial; max-height: initial; margin-top: 14px; margin-bottom: 1px;">
                <ui:VisualElement picking-mode="Ignore" style="min-height: 20px; max-height: 20px; min-width: 20px; flex-direction: row; justify-content: space-between; background-color: rgba(0, 0, 0, 0.06); border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; flex-grow: 1; margin-bottom: 3px;">
                    <ui:VisualElement name="LayerIcon" style="flex-grow: 0; width: 20px; height: 20px; border-left-color: rgba(130, 130, 130, 0); border-right-color: rgba(130, 130, 130, 0); border-top-color: rgba(130, 130, 130, 0); border-bottom-color: rgba(130, 130, 130, 0); background-color: rgba(0, 0, 0, 0.15); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px;" />
                    <ui:Label text="Name" display-tooltip-when-elided="true" name="LayerName" picking-mode="Ignore" style="margin-left: 11px; margin-right: 6px; margin-top: 0; margin-bottom: 0; flex-grow: 1; min-width: 0; -unity-text-align: middle-left; color: rgba(210, 210, 210, 0.76); -unity-font-style: italic; font-size: 12px;" />
                    <ui:Button display-tooltip-when-elided="true" name="ClearLayerButton" class="AnimatedButton clear-button" style="margin-left: 1px; margin-right: 1px; margin-top: 1px; margin-bottom: 1px; min-width: 18px; max-width: 18px; min-height: 18px; max-height: 18px; -unity-font-style: bold; color: rgba(157, 157, 157, 0.93); opacity: 0.65; border-top-left-radius: 60px; border-bottom-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-left-color: rgb(19, 19, 19); border-right-color: rgb(19, 19, 19); border-top-color: rgb(19, 19, 19); border-bottom-color: rgb(19, 19, 19); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;" />
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" style="min-height: 20px; max-height: 20px; min-width: 20px; flex-direction: row; justify-content: space-between; background-color: rgba(0, 0, 0, 0.06); border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; flex-grow: 1; margin-bottom: 3px;">
                    <ui:VisualElement name="MaskIcon" style="flex-grow: 0; width: 20px; height: 20px; border-left-color: rgba(130, 130, 130, 0); border-right-color: rgba(130, 130, 130, 0); border-top-color: rgba(130, 130, 130, 0); border-bottom-color: rgba(130, 130, 130, 0); background-color: rgba(0, 0, 0, 0.15); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px;" />
                    <ui:Label text="Name" display-tooltip-when-elided="true" name="MaskName" picking-mode="Ignore" style="margin-left: 12px; margin-right: 6px; margin-top: 0; margin-bottom: 0; flex-grow: 1; min-width: 0; -unity-text-align: middle-left; color: rgba(210, 210, 210, 0.76); -unity-font-style: italic; font-size: 12px; overflow: hidden; visibility: visible; display: flex;" />
                    <ui:Button display-tooltip-when-elided="true" name="ClearMaskButton" class="AnimatedButton clear-button" style="margin-left: 1px; margin-right: 1px; margin-top: 1px; margin-bottom: 1px; min-width: 18px; max-width: 18px; min-height: 18px; max-height: 18px; opacity: 0.65; border-top-left-radius: 60px; border-bottom-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-left-color: rgba(0, 0, 0, 0.73); border-right-color: rgba(0, 0, 0, 0.73); border-top-color: rgba(0, 0, 0, 0.73); border-bottom-color: rgba(0, 0, 0, 0.73); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-direction: row; justify-content: center; top: -89px; height: 22px; flex-grow: 1;">
            <ui:VisualElement name="DrapPoint" style="height: 19px; top: -7px; width: 211px; align-items: center; justify-content: center;">
                <ui:VisualElement class="AnimatedDrapPoint" style="width: 71px; height: 8px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:GroupBox>
</ui:UXML>
