<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/MrPathV2/Editor/Inspectors/PathProfileEditor.uss?fileID=7433441132597879392&amp;guid=036bccdb4eb9e0e40a55bc40ccb90145&amp;type=3#PathProfileEditor" />
    <ui:GroupBox picking-mode="Ignore" class="settings-group" style="flex-shrink: 1; flex-direction: column; justify-content: space-around; align-items: stretch; flex-grow: 1; padding-left: 6px; padding-right: 6px; padding-top: 6px; padding-bottom: 6px; margin-left: 5px; margin-right: 5px; margin-top: 5px; margin-bottom: 5px;">
        <ui:VisualElement focusable="false" tabindex="0" picking-mode="Ignore" style="flex-direction: row; justify-content: flex-end; align-items: center; width: auto; flex-grow: 0; flex-shrink: 1; flex-wrap: nowrap; margin-left: 16px; margin-right: 11px; margin-top: 4px; margin-bottom: 4px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;">
            <ui:Toggle name="Activelayer" style="flex-shrink: 1; flex-grow: 0; margin-left: 0; margin-right: 5px; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; justify-content: flex-start; flex-direction: row; align-items: center; left: auto;" />
            <ui:Label text="Layer" display-tooltip-when-elided="true" name="Layername" style="margin-left: 4px; margin-right: 0; flex-shrink: 1; flex-grow: 1; font-size: 16px; -unity-font-style: normal; padding-left: 0; padding-right: 2px; -unity-text-align: middle-left; left: auto;" />
            <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; margin-left: 256px; min-height: 20px; margin-right: 0; padding-left: 0; padding-right: 0; flex-direction: row; align-items: stretch; justify-content: space-between;">
                <ui:Label text="==" display-tooltip-when-elided="true" picking-mode="Ignore" style="-unity-text-align: middle-center; white-space: nowrap; align-items: center; justify-content: space-between; flex-direction: row; flex-shrink: 1; left: -140px; opacity: 0.27;" />
            </ui:VisualElement>
            <ui:VisualElement style="width: 29px; height: auto; margin-left: 6px; margin-right: 0; margin-top: 1px; margin-bottom: 0; border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; flex-grow: 0;">
                <ui:Button text="X" display-tooltip-when-elided="true" name="RemoveLayer" style="margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; flex-shrink: 1; flex-grow: 1; -unity-font-style: bold; color: rgb(226, 85, 85); border-top-left-radius: 6px; border-bottom-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; background-color: rgb(81, 81, 81); width: auto; white-space: nowrap; -unity-text-align: middle-center;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="left: auto; width: auto; margin-left: 5px; margin-right: 5px; padding-right: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; flex-grow: 1; margin-top: 5px; margin-bottom: 5px;">
            <ui:VisualElement style="align-items: center; flex-direction: row; justify-content: space-between; flex-grow: 1; min-height: 20px; max-height: 20px; margin-top: 1px; margin-bottom: 4px; padding-left: 9px; padding-right: 6px;">
                <ui:DropdownField index="-1" choices="System.Collections.Generic.List`1[System.String]" name="BlendModelEnum" style="width: auto; flex-shrink: 1; max-width: 300px; min-width: 30%; min-height: 20px; justify-content: space-between; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; max-height: 20px;" />
                <ui:Slider picking-mode="Ignore" value="42" high-value="100" name="LayerOpacity" style="width: auto; flex-shrink: 1; min-width: 70%; max-width: 70%; min-height: 20px; margin-left: 36px; margin-right: 0; margin-top: 0; margin-bottom: 0; max-height: 20px;" />
            </ui:VisualElement>
            <ui:VisualElement style="min-height: 20px; max-height: 20px; min-width: 20px; flex-direction: row; justify-content: space-between; background-color: rgba(0, 0, 0, 0.06); border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; margin-left: 10px; margin-right: 6px; margin-top: 2px; margin-bottom: 2px;">
                <ui:VisualElement name="LayerIcon" style="flex-grow: 1; width: auto; flex-shrink: 0; height: auto; max-width: none; max-height: none; min-width: auto; border-left-color: rgba(130, 130, 130, 0); border-right-color: rgba(130, 130, 130, 0); border-top-color: rgba(130, 130, 130, 0); border-bottom-color: rgba(130, 130, 130, 0); background-color: rgba(0, 0, 0, 0.15); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 2px; margin-right: 2px; margin-top: 2px; margin-bottom: 2px;" />
