                <ui:Button text="C" display-tooltip-when-elided="true" name="ClearButton" style="margin-left: 1px; margin-right: 1px; margin-top: 1px; margin-bottom: 1px; min-width: 18px; max-width: 18px; min-height: 18px; max-height: 18px; -unity-font-style: bold; color: rgba(212, 121, 121, 0.93);" />
            </ui:VisualElement>
            <ui:VisualElement style="min-height: 20px; max-height: 20px; min-width: 20px; flex-direction: row; justify-content: space-between; background-color: rgba(0, 0, 0, 0.06); border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; margin-left: 10px; margin-right: 6px; margin-top: 2px; margin-bottom: 2px;">
                <ui:VisualElement name="MaskIcon" style="flex-grow: 1; width: auto; flex-shrink: 0; height: auto; max-width: none; max-height: none; min-width: auto; border-left-color: rgba(130, 130, 130, 0); border-right-color: rgba(130, 130, 130, 0); border-top-color: rgba(130, 130, 130, 0); border-bottom-color: rgba(130, 130, 130, 0); background-color: rgba(0, 0, 0, 0.15); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 2px; margin-right: 2px; margin-top: 2px; margin-bottom: 2px;" />
                <ui:Label text="Name" display-tooltip-when-elided="true" name="MaskName" style="margin-left: 104px; margin-right: 0; margin-top: 0; margin-bottom: 0; width: 231px; -unity-text-align: middle-left;" />
                <ui:Button text="C" display-tooltip-when-elided="true" name="ClearButton" style="margin-left: 1px; margin-right: 1px; margin-top: 1px; margin-bottom: 1px; min-width: 18px; max-width: 18px; min-height: 18px; max-height: 18px; -unity-font-style: bold; color: rgba(212, 121, 121, 0.93);" />
