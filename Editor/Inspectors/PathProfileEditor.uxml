<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/__temp/MrPathV2.2/Editor/Inspectors/PathProfileEditor.uss?fileID=7433441132597879392&amp;guid=036bccdb4eb9e0e40a55bc40ccb90145&amp;type=3#PathProfileEditor" />
    <ui:VisualElement class="root-container" style="height: 902px; flex-grow: 1;">
        <ui:VisualElement class="control-panel">
            <ui:GroupBox name="CoreSettings" class="settings-group">
                <ui:Label text="Core Settings" class="group-header" />
                <ui:VisualElement class="field-row">
                    <uie:EnumField label="Curve Type" binding-path="curveType" name="CurveTypeField" class="compact-field" />
                    <uie:FloatField label="Mesh Width" binding-path="roadWidth" name="RoadWidthField" class="compact-field" />
                </ui:VisualElement>
            </ui:GroupBox>
            <ui:GroupBox name="CrossSection" class="settings-group">
                <ui:Label text="Cross Section" class="group-header" />
                <uie:FloatField label="Edge Width" binding-path="falloffWidth" name="FalloffWidthField" class="wide-field" />
                <uie:CurveField label="Section Profile" binding-path="crossSection" name="CrossSectionCurveField" class="curve-field" />
                <uie:CurveField label="Edge Shape" binding-path="falloffShape" name="FalloffShapeCurveField" class="curve-field" />
            </ui:GroupBox>
            <ui:GroupBox name="TerrainSnap" class="settings-group" style="flex-grow: 1;">
                <ui:Toggle label="TerrainSnapping" name="TerrainSnapping" style="flex-shrink: 1; flex-grow: 1;" />
                <uie:FloatField label="Height Offset" binding-path="heightOffset" name="HeightOffsetField" class="readonly-field" />
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:GroupBox name="PreviewSection" class="preview-group">
            <ui:Label text="Mesh Preview" class="group-header" />
            <ui:VisualElement class="preview-controls" style="justify-content: space-between; align-items: stretch; overflow: visible; flex-grow: 0; height: 59px; flex-direction: column; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 8px; margin-right: 8px;">
                <ui:Toggle label="ShowMesh" name="ShowMeshToggle" class="preview-toggle" style="flex-shrink: 1; flex-grow: 1; justify-content: space-around; margin-left: 0; margin-right: 13px;" />
                <ui:Toggle label="DepthTest" name="EnableDepthTestToggle" value="false" class="preview-toggle" style="flex-shrink: 1; flex-grow: 1; position: relative; justify-content: flex-start; margin-right: 13px; margin-left: 0; align-items: stretch;" />
                <ui:Toggle label="Snapping" name="SnappingToggle" value="false" class="preview-toggle" style="flex-shrink: 1; flex-grow: 0; justify-content: space-around; flex-wrap: nowrap; flex-direction: row; margin-right: 13px; padding-right: 0; align-items: stretch; opacity: 1; overflow: visible; margin-left: 0;" />
            </ui:VisualElement>
            <uie:ObjectField label="Recipe" binding-path="roadRecipe" name="RecipeField" class="object-field" />
            <ui:VisualElement name="preview-content" class="preview-content" />
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
