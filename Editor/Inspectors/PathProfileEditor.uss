.root-container {
    flex-direction: column;
    padding: 10px;
    background-color: rgb(40, 40, 40);
}

.control-panel {
    flex-direction: column;
    gap: 15px;
    margin-bottom: 15px;
}

.settings-group {
    flex-direction: column;
    background-color: rgb(30, 30, 30);
    border-radius: 4px;
    padding: 12px;
    border-left: 2px solid rgb(70, 70, 70);
}

.group-header {
    font-size: 14px;
    font-weight: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgb(60, 60, 60);
}

.field-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.compact-field {
    min-width: 120px;
    flex-grow: 1;
    margin: 0 5px;
}

.wide-field {
    margin: 8px 0;
}

.wide-slider {
    margin: 12px 0;
}

.curve-field {
    height: 80px;
    margin: 8px 0;
}

.preview-group {
    flex-grow: 1;
    background-color: rgb(35, 35, 35);
    padding: 12px;
}

.preview-controls {
    flex-direction: row;
    gap: 10px;
    margin-bottom: 10px;
}

.preview-toggle {
    font-size: 12px;
    margin-left: 13px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    translate: 0 0;
}

.preview-content {
    flex-grow: 1;
    min-height: 200px;
    background-color: rgb(25, 25, 25);
    margin-top: 10px;
}

.readonly-field {
    opacity: 0.7;
}

.object-field {
    margin-top: 10px;
}
