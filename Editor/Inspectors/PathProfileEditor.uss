.root-container {
    flex-direction: column;
    padding: 10px;
    background-color: rgba(40, 40, 40, 0.23);
    border-top-left-radius: 9px;
    border-bottom-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}

.control-panel {
    flex-direction: column;
    top: 15px;
    margin-bottom: 15px;
}

.settings-group {
    flex-direction: column;
    background-color: rgba(30, 30, 30, 0.2);
    border-radius: 4px;
    padding: 12px;
    border-left-color: rgb(70, 70, 70);
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

.group-header {
    font-size: 14px;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-color: rgb(60, 60, 60);
    -unity-font-style: bold;
}

.field-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
    padding-left: 9px;
    padding-right: 6px;
}

.compact-field {
    min-width: 120px;
    flex-grow: 1;
    margin: 0 5px;
}

.wide-field {
    margin: 8px 0;
    margin-top: 8px;
    margin-bottom: -4px;
    padding-left: 9px;
    padding-right: 6px;
}

.wide-slider {
    margin: 12px 0;
}

.curve-field {
    height: 80px;
    margin: 8px 0;
}

.preview-group {
    flex-grow: 1;
    background-color: rgb(35, 35, 35);
    padding: 12px;
    border-top-left-radius: 9px;
    border-bottom-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}

.preview-controls {
    flex-direction: row;
    top: 10px;
    margin-bottom: 10px;
}

.preview-toggle {
    font-size: 12px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 9px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    translate: 0 0;
}

.preview-content {
    flex-grow: 1;
    min-height: 200px;
    background-color: rgb(25, 25, 25);
    margin-top: 10px;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-radius: 6px;
}

.readonly-field {
    opacity: 0.7;
    padding-left: 9px;
    padding-right: 6px;
    color: rgb(255, 255, 255);
}

.object-field {
    margin-top: 10px;
}

.compact-enum {
    min-width: 120px;
    margin: 0 5px;
}

.wide-enum {
    margin: 8px 0;
}
