.tile-icon {
    /* 初始 1px 灰色边框，并启用平滑过渡 */
    border-width: 1px;
    border-color: rgb(64, 64, 64);
    transition-property: border-color, border-width;
    transition-duration: 0.2s;
    transition-timing-function: ease;
}

/* 悬停仅改变边框颜色（不改变宽度），避免覆盖 selected 的 2px */
.tile-icon:hover {
    border-color: rgb(90, 153, 255);
}

/* 选中态：2px 橙色边框。该规则位置靠后以覆盖 :hover */
.selected .tile-icon {
    border-width: 2px;
    border-color: rgb(255, 153, 0);
}
